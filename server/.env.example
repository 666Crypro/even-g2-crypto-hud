# Copy to server/.env (git-ignored) and export, or set in your host's dashboard. Everything is optional.

# --- Telegram companion bot (create one yourself with @BotFather) ---
TELEGRAM_BOT_TOKEN=
# TG_DEMO=1            # no token: seed a sample group feed and log "sends" locally (for the simulator demo)

# --- Voice (push-to-talk). Any OpenAI-compatible /audio/transcriptions endpoint ---
# STT_API_KEY=sk-...                     # OpenAI Whisper (default base URL)
# STT_BASE_URL=https://api.groq.com/openai/v1   STT_MODEL=whisper-large-v3-turbo
# STT_BASE_URL=http://127.0.0.1:9000/v1  # free local server: scripts/local-stt.py (faster-whisper)

# --- Read-only data you want on the POSITIONS card (can also be set on the phone screen) ---
# HL_WATCH_ADDRESS=0x...   # Hyperliquid account (positions, PnL, liq price)
# WALLET_ADDRESS=0x...     # e.g. your Trust Wallet EVM address (ETH + USDC on Ethereum and Base)
# WATCHLIST=BTC,ETH,SOL,HYPE

# --- Optional: send confirmed orders to Hyperliquid TESTNET instead of paper. Never a mainnet key. ---
# HL_TESTNET_PRIVATE_KEY=0x...

# PORT=8787
# HUD_TZ=America/Los_Angeles
